# ---------------------------------------------------------------
# Unity 工程标准忽略规则
# 说明：Library/ Temp/ Logs/ UserSettings/ 全部是 Unity 本机生成的缓存，
#       *.csproj / *.sln 也由 Unity 每次刷新时重新生成，都不该入库。
# ---------------------------------------------------------------

# Unity 生成目录
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity 自动生成的工程/解决方案文件（只会生成在工程根目录，所以只忽略根目录的）
# 注意别写成 *.csproj —— 那会把手写的测试工程（Tests~/Standalone/*.csproj）一起挡掉
/*.csproj
/*.unityproj
/*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# IDE
.vs/
.idea/
*.DotSettings.user

# 构建与导出产物
/[Aa]ssets/[Aa]ssetStoreTools*
/[Ee]xportedObj/
crashlytics-build.properties
sysinfo.txt

# 子工程（如 Tests~/Standalone）的编译输出
**/bin/
**/obj/

# 编辑器崩溃/临时文件
*.stackdump
*.tmp

# 操作系统
.DS_Store
Thumbs.db

# 本机备份
manifest.json.bak

# Samples/ 下的前后对照样例工程（它们是独立 Unity 工程，打开后会生成同样的本地目录）
/Samples/*/[Ll]ibrary/
/Samples/*/[Tt]emp/
/Samples/*/[Oo]bj/
/Samples/*/[Bb]uild/
/Samples/*/[Bb]uilds/
/Samples/*/[Ll]ogs/
/Samples/*/[Uu]ser[Ss]ettings/
/Samples/*/[Mm]emoryCaptures/
/Samples/*/*.csproj
/Samples/*/*.unityproj
/Samples/*/*.sln

# PerfAgent 的运行状态：快照 / 对话记录 / 修复日志 / 本机设置
# 作者刻意把它放在 ProjectSettings/ 下就是为了避免误提交（见 PerfAgentSettings.cs 注释），
# 这里显式忽略。这些都是跑一次就变的本机数据，且快照动辄几百 KB。
/ProjectSettings/PerfAgent/
